# NEXUS Siembras — Variables de entorno
# Copiar este archivo a `.env` (mismo directorio) y completar valores reales.
#
# Pasos para obtener SUPABASE_URL y SUPABASE_ANON_KEY:
#   1. Crear cuenta gratis en https://supabase.com/dashboard
#   2. New Project → asignar nombre "nexus-siembras" (o el que prefiera)
#      → contraseña de BD (guardarla) → región cercana → Create
#   3. En el proyecto: Settings → API
#      - "Project URL" → SUPABASE_URL
#      - "anon public" key (NO la service_role) → SUPABASE_ANON_KEY
#   4. Reiniciar la app (hot restart no basta para .env)
#
# Sin estas variables, la app funciona en modo 100% local (sin sync ni auth).

SUPABASE_URL=https://llxaxdyczysfktvdpqwj.supabase.co
# Preferida: publishable key (Settings → API → "Publishable key", empieza
# con sb_publishable_). La anon key legacy (JWT) sigue funcionando como
# respaldo, pero conviene rotarla y deshabilitarla (auditoría S1).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ev4q-8r11G5gsLYhdxO0Tg_afJs4Hv_
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxseGF4ZHljenlzZmt0dmRwcXdqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMxMzM5MjEsImV4cCI6MjA5ODcwOTkyMX0.Fo3IPAUrMeGSs7mlSoyNi7pQOftSkkTIEELegLwXCos

# Modo de sincronización: local_only | online_first | offline_first
SYNC_MODE=offline_first