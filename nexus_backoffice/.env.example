# NEXUS Siembras — Backoffice
# Copiar a .env.local (desarrollo) y cargar en Netlify → Site settings →
# Environment variables (producción).

# ---------------------------------------------------------------------
# Públicas (llegan al navegador — solo claves de bajo privilegio)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# ---------------------------------------------------------------------
# SECRETA — solo servidor. NUNCA prefijar con NEXT_PUBLIC_.
# Da acceso total saltándose RLS: se usa exclusivamente en Server Actions
# y Route Handlers (ver src/lib/supabase/admin.ts).
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Email de arranque autorizado para entrar al backoffice (solo .env local /
# Netlify — NUNCA un correo real en el repo). La lista canónica vive en
# `admin_allowlist` (migración 0017). Ver README §2.4.
ADMIN_EMAIL_BOOTSTRAP=email@domain.com
